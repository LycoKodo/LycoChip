set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name SDC_FILE mnist.sdc

# --- RTL ---------------------------------------------------------------------
# One line per file under rtl/. A module missing here is an error at
# elaboration, not a silent drop. Testbenches (tb/) never go here.
# set_global_assignment -name VERILOG_FILE rtl/top.v

# Unassigned pins stay tri-stated inputs so nothing on the board is driven
# by accident.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# Emit a raw .rbf next to the .sof, for writing the config flash.
set_global_assignment -name GENERATE_RBF_FILE ON

# Match the server core count (i5-6300U, 4 threads).
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

# --- Pins (OMDAZZ Cyclone IV V3.0) -------------------------------------------
# Yours to write once top's port list exists: the names here must match the
# ports' declared shape exactly. Board facts are in CLAUDE.md Article V.
# NOTE: no trailing "; #" comments, and keep a newline after the last line.
