# Auto detect text files and perform LF normalization
* text=auto

# Never let newline normalisation touch a bitstream or a flash image.
# backup/factory_flash_2MB.bin is the board's irreplaceable factory demo --
# a mangled copy would be silently useless.
*.bin binary
*.sof binary
*.rbf binary
*.pof binary
*.jic binary
*.qdz binary

# Vendor documentation
*.pdf binary
*.xls binary
*.xlsx binary
*.jpg binary
*.png binary

# Scripts and HDL sources are LF on every machine. Bash wants LF, and
# tools/artifacts.py hashes source *bytes* -- a CRLF checkout on Windows would
# give the same commit a different source_sha256 than the Mac, and the
# cross-machine "same sources" comparisons in PROGRESS.md would quietly break.
*.sh  text eol=lf
*.py  text eol=lf
*.v   text eol=lf
*.sv  text eol=lf
*.vhd text eol=lf
*.qsf text eol=lf
*.qpf text eol=lf
*.sdc text eol=lf
*.tcl text eol=lf
